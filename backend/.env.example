NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=https://your-frontend.vercel.app
# Free Render disk is ephemeral: this account is re-created on every boot
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin
# ALLOW_REGISTRATION=false

# Optional MongoDB storage (users, cameras, alerts, settings survive restarts).
# Leave unset to keep everything in memory. DB name: MONGODB_DB, else the URI path, else "visionshield".
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/visionshield
# MONGODB_DB=visionshield

# Tuning (defaults shown)
# PPE_CONF=0.5
# PERSON_CONF=0.4
# NMS_IOU=0.6
# MAX_UPLOAD_MB=8
# DETECT_RATE_PER_MIN=60

# LINE notifications (Messaging API). Leave empty to keep the toggle disabled.
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_TO=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LINE_COOLDOWN_SEC=60
